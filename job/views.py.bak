def apply_now(request, id):
    if not request.user.is_authenticated:
        return redirect('user_login')

    user = request.user
    student = StudentUser.objects.filter(user=user).first()
    job = Job.objects.filter(id=id).first()
    if job is None:
        return redirect('user_home')

    user_email = user.email or user.username
    # Prevent duplicate applications for the same user and job
    if Applyjob.objects.filter(email=user_email, num=id).exists():
        request.session['apply_message'] = 'You have already applied for this job.'
        return redirect('user_home')

    if not _is_user_eligible_for_job(user, job):
        request.session['eligibility_message'] = 'You are not eligible for this job.'
        return redirect('user_home')

    if request.method == 'GET' and request.GET.get('proceed') != '1':
        return render(request, 'apply_confirm.html', {'job': job, 'user': user})

    error = ""
    if request.method == 'POST':
        f = request.POST.get('fname') or user.first_name
        l = request.POST.get('lname') or user.last_name
        con = request.POST.get('contact') or (student.mobile if student else '')
        email = request.POST.get('email') or (user.email or user.username)
        ex = request.POST.get('exp') or (student.experience if student else '0')
        q = request.POST.get('que') or (student.qualification if student else '')
        g = request.POST.get('gender') or (student.gender if student else '')
        i = request.FILES.get('image') or (student.image if student else None)
    resume_file = request.FILES.get('resume')

    if student:
        if not student.qualification and q:
            student.qualification = q
        if not student.experience and ex:
            student.experience = ex
        if not student.gender and g:
            student.gender = g
        if not student.mobile and con:
            student.mobile = con
        student.save()

    if not con or not q or not g:
        error = 'yes'
    else:
        try:
            # Save application with optional resume
            app_kwargs = dict(fname=f, lname=l, mobile=con, email=email, experience=ex,
                              qualification=q, gender=g, image=i, num=id, status='Pending')
            if resume_file:
                app_kwargs['resume'] = resume_file
            Applyjob.objects.create(**app_kwargs)
            return redirect('apply_success', id=id)
        except Exception:
            error = 'yes'

    d = {'user': user, 'student': student, 'error': error, 'job': job}
    return render(request, 'apply_now.html', d)


def download_resume(request, id):
    # Allow recruiter, staff, or the applicant to download resume attached to an application
    try:
        application = Applyjob.objects.get(id=id)
    except Applyjob.DoesNotExist:
        return redirect('applied_condidate_list')

    if not application.resume:
        request.session['apply_message'] = 'No resume is attached to this application.'
        return redirect('applied_condidate_list')

    user = request.user
    allowed = False
    if user.is_authenticated and (user.is_staff or (application.email and (user.email == application.email or user.username == application.email))):
        allowed = True
    else:
        # allow job's recruiter
        try:
            job = Job.objects.get(id=application.num)
            if job and job.recuiter and user.is_authenticated and job.recuiter.user == user:
                allowed = True
        except Job.DoesNotExist:
            pass

    if not allowed:
        request.session['apply_message'] = 'You are not authorized to download this resume.'
        return redirect('applied_condidate_list')

    # Serve the file
    from django.http import FileResponse
    try:
        return FileResponse(application.resume.open('rb'), as_attachment=True, filename=f"Resume_{application.fname}_{application.lname}_{application.id}{application.resume.name and '.' + application.resume.name.split('.')[-1] or ''}")
    except Exception:
        request.session['apply_message'] = 'Failed to retrieve resume file.'
        return redirect('applied_condidate_list')


