def forgot_password(request):
    error = ""
    identifier = request.session.get('reset_identifier', '')

    if request.GET.get('resend') == '1' and identifier:
        user = _find_user_by_identifier(identifier)
        if user is not None:
            otp = str(random.randint(100000, 999999))
            request.session['reset_user_id'] = user.id
            request.session['reset_otp'] = otp
            request.session['reset_otp_time'] = time.time()
            request.session['reset_verified'] = False
            channel = _detect_reset_channel(identifier)
            request.session['reset_otp_channel'] = channel
            request.session['reset_otp_demo'] = otp if channel == 'mobile' else ''
            if channel == 'mobile':
                _send_otp_sms(user, otp)
                return redirect('verify_otp')
            email_sent = _send_otp_email(user, otp)
            if not email_sent:
                _clear_reset_session(request)
                return render(request, 'forgot_password.html', {'error': 'invalid', 'identifier': identifier})
            return redirect('verify_otp')

    if request.method == 'POST':
        identifier = request.POST.get('identifier', '').strip()
        request.session['reset_identifier'] = identifier
        user = _find_user_by_identifier(identifier)
        if user is None:
            error = 'invalid'
        else:
            otp = str(random.randint(100000, 999999))
            request.session['reset_user_id'] = user.id
            request.session['reset_otp'] = otp
            request.session['reset_otp_time'] = time.time()
            request.session['reset_verified'] = False
            channel = _detect_reset_channel(identifier)
            request.session['reset_otp_channel'] = channel
            request.session['reset_otp_demo'] = otp if channel == 'mobile' else ''

            if channel == 'mobile':
                _send_otp_sms(user, otp)
                return redirect('verify_otp')

            email_sent = _send_otp_email(user, otp)
            if not email_sent:
                error = 'invalid'
                _clear_reset_session(request)
                return render(request, 'forgot_password.html', {'error': error, 'identifier': identifier})
            return redirect('verify_otp')
    return render(request, 'forgot_password.html', {'error': error, 'identifier': identifier})


def verify_otp(request):
    if not request.session.get('reset_user_id'):
        return redirect('forgot_password')

    error = ""
    reset_otp_time = request.session.get('reset_otp_time', 0)
    seconds_left = max(0, 60 - int(time.time() - float(reset_otp_time)))
    channel = request.session.get('reset_otp_channel', 'email')

    if request.method == 'POST':
        entered_otp = (request.POST.get('otp') or '').strip()
        stored_otp = request.session.get('reset_otp')
        stored_time = request.session.get('reset_otp_time', 0)

        if not stored_otp or (time.time() - float(stored_time)) > 60:
            error = 'expired'
            _clear_reset_session(request)
        elif entered_otp == stored_otp:
            request.session['reset_verified'] = True
            return redirect('reset_password')
        else:
            error = 'invalid'

    demo_otp = request.session.get('reset_otp_demo', '')
    return render(request, 'verify_otp.html', {'error': error, 'seconds_left': seconds_left, 'channel': channel, 'demo_otp': demo_otp})


def reset_password(request):
    if not request.session.get('reset_user_id') or not request.session.get('reset_verified'):
        return redirect('forgot_password')

    error = ""
    if request.method == 'POST':
        pwd = request.POST.get('password')
        cpwd = request.POST.get('confirm_password')
        if not pwd or not cpwd:
            error = 'invalid'
        elif pwd != cpwd:
            error = 'match'
        else:
            user = User.objects.get(id=request.session['reset_user_id'])
            user.set_password(pwd)
            user.save()
            _clear_reset_session(request)

            if user.is_staff:
                return redirect('admin_login')
            if StudentUser.objects.filter(user=user, type='student').exists():
                return redirect('user_login')
            if Recuiter.objects.filter(user=user, type='recuiter').exists():
                return redirect('recuiter_login')
            return redirect('user_login')

    return render(request, 'reset_password.html', {'error': error})


def recuiter_login(request):
    error = ""
    if request.method == "POST":
        u = (request.POST.get('uname') or '').strip()
        p = request.POST.get('pwd') or ''
        user = None
        try:
            user = authenticate(username=u, password=p)
        except Exception:
            user = None
        if user is None and u:
            try:
                user_obj = User.objects.filter(email=u).first()
                if user_obj:
                    user = authenticate(username=user_obj.username, password=p)
            except Exception:
                user = None
        if user:
            try:
                user1 = Recuiter.objects.filter(user=user, type='recuiter').first()
                if user1 and user1.status != 'pending':
                    login(request, user)
                    error = "no"
                else:
                    error = "not"
            except Exception:
                error = "yes"
        else:
            error = "yes"
    d = {'error': error}
    return render(request, 'recuiter_login.html', d)


def recuiter_signup(request):
    error = ""
    form_data = request.POST.copy() if request.method == 'POST' else {}
    email_otp_value = (request.POST.get('email_otp') or '').strip()
    mobile_otp_value = (request.POST.get('mobile_otp') or '').strip()
    pending_signup_data = request.session.get('pending_signup_data')
    pending_email_otp = request.session.get('pending_signup_email_otp')
    pending_mobile_otp = request.session.get('pending_signup_mobile_otp')
    demo_mobile_otp = request.session.get('pending_signup_demo_mobile_otp', '')
    demo_email_otp = request.session.get('pending_signup_demo_email_otp', '')
    otp_value = email_otp_value or mobile_otp_value

    # If the user navigates back (GET) to the signup page while a pending signup exists,
    # support explicit resend and cancel. If GET without action, clear pending to avoid getting stuck on OTP.
    pending_seconds_left = 0
    if request.method == 'GET':
        if request.GET.get('cancel_pending') == '1':
            _clear_pending_signup(request)
            return redirect('recuiter_signup')
        if request.GET.get('resend_otp') == '1' and pending_signup_data:
            # enforce a 60-second resend cooldown
            last = float(request.session.get('pending_signup_otp_time', 0) or 0)
            elapsed = time.time() - last
            if elapsed < 60:
                # do not regenerate - inform template via error flag; pending data remains until explicit cancel
                error = 'resend_wait'
            else:
                signup_type = request.session.get('pending_signup_type', 'recuiter')
                email_otp, mobile_otp = _save_pending_signup(request, signup_type, pending_signup_data)
                try:
                    send_mail('Email Verification OTP', f'Your signup email verification OTP is: {email_otp}. This code is valid for 1 minute.', settings.DEFAULT_FROM_EMAIL or 'no-reply@example.com', [pending_signup_data.get('email')], fail_silently=True)
                except Exception:
                    pass
                # Redirect so template reads the session-based pending payload
                return redirect('recuiter_signup')

        elif pending_signup_data:
            # user navigated back - clear pending so form becomes blank per user request
            _clear_pending_signup(request)
            pending_signup_data = None
            pending_email_otp = None
            pending_mobile_otp = None
            demo_mobile_otp = ''

    if request.session.get('pending_signup_otp_time'):
        pending_seconds_left = max(0, 60 - int(time.time() - float(request.session.get('pending_signup_otp_time', 0))))

    if request.method == 'POST' and (email_otp_value or mobile_otp_value):
        if pending_signup_data and (pending_email_otp or pending_mobile_otp):
            if (time.time() - float(request.session.get('pending_signup_otp_time', 0))) > 60:
                error = 'otp_expired'
                _clear_pending_signup(request)
            elif email_otp_value == (pending_email_otp or '') and mobile_otp_value == (pending_mobile_otp or ''):
                payload = pending_signup_data
                try:
                    user = User.objects.create_user(first_name=payload.get('fname', '').strip(), last_name=payload.get('lname', '').strip(), username=payload.get('email', '').strip(), email=payload.get('email', '').strip(), password=payload.get('pwd', ''))
                    Recuiter.objects.create(user=user, mobile=payload.get('contact', '').strip(), image=request.FILES.get('image') if request.FILES else None, gender=payload.get('gender', '').strip(), company=payload.get('company', '').strip(), type='recuiter', status='pending')
                    _clear_pending_signup(request)
                    return render(request, 'recuiter_signup.html', {'error': 'no', 'form_data': {}})
                except Exception:
                    error = 'yes'
                    _clear_pending_signup(request)
            else:
                error = 'otp_invalid'
        else:
            error = 'otp_invalid'

    if request.method == 'POST' and not (email_otp_value or mobile_otp_value) and not pending_signup_data:
        f = (request.POST.get('fname') or '').strip()
        l = (request.POST.get('lname') or '').strip()
        i = request.FILES.get('image')
        p = request.POST.get('pwd') or ''
        e = (request.POST.get('email') or '').strip()
        con = (request.POST.get('contact') or '').strip()
        gen = (request.POST.get('gender') or '').strip()
        company = (request.POST.get('company') or '').strip()

        if not all([f, p, e, con, gen, company]):
            error = 'required'
        elif not is_valid_mobile_number(con):
            error = 'mobile'
        elif not is_valid_gmail_email(e):
            error = 'gmail'
        elif User.objects.filter(email__iexact=e).exists() or User.objects.filter(username__iexact=e).exists():
            error = 'exists'
        else:
            payload = {'fname': f, 'lname': l, 'pwd': p, 'email': e, 'contact': con, 'gender': gen, 'company': company}
            email_otp, mobile_otp = _save_pending_signup(request, 'recuiter', payload)
            try:
                send_mail('Email Verification OTP', f'Your signup email verification OTP is: {email_otp}. This code is valid for 1 minute.', settings.DEFAULT_FROM_EMAIL or 'no-reply@example.com', [e], fail_silently=False)
            except Exception:
                pass
            # Use PRG to render OTP UI from session-backed pending payload
            return redirect('recuiter_signup')

    if pending_signup_data and not (email_otp_value or mobile_otp_value):
        form_data = pending_signup_data
        pending_email_otp = request.session.get('pending_signup_email_otp')
        pending_mobile_otp = request.session.get('pending_signup_mobile_otp')
        demo_mobile_otp = request.session.get('pending_signup_demo_mobile_otp', pending_mobile_otp)
        error = error or 'otp_required'

    d = {
        'error': error,
        'form_data': form_data,
        'pending_otp': bool(pending_signup_data and not (email_otp_value or mobile_otp_value)),
        'demo_mobile_otp': demo_mobile_otp,
        'demo_email_otp': demo_email_otp,
        'pending_seconds_left': pending_seconds_left
    }
    return render(request, 'recuiter_signup.html', d)


def user_profile(request):
    if not request.user.is_authenticated:
        return redirect('user_login')

    user = request.user
    student = StudentUser.objects.filter(user=user).first()
    if student is None:
        return redirect('user_home')

    error = ""
    selected_interests = [item.strip() for item in (student.interest or '').split(',') if item.strip()]
    if request.method == 'POST':
        first_name = (request.POST.get('fname') or '').strip()
        last_name = (request.POST.get('lname') or '').strip()
        mobile = (request.POST.get('contact') or '').strip()
        gender = (request.POST.get('gender') or '').strip()
        qualification = (request.POST.get('qualification') or '').strip()
        experience = (request.POST.get('experience') or '').strip()
        selected_interests = request.POST.getlist('interest')
        image = request.FILES.get('image')
        resume = request.FILES.get('resume')

        if not first_name or not mobile or not gender or not qualification or not experience or not selected_interests:
            error = 'required'
        elif not is_valid_mobile_number(mobile):
            error = 'mobile'
        else:
            user.first_name = first_name
            user.last_name = last_name
            user.save()
            student.mobile = mobile
            student.gender = gender
            student.qualification = qualification
            student.experience = experience
            student.interest = ', '.join(selected_interests)
            if image is not None:
                student.image = image
            if resume is not None:
                student.resume = resume
            student.save()
            error = 'no'
            selected_interests = [item.strip() for item in student.interest.split(',') if item.strip()]

    d = {'student': student, 'error': error, 'selected_interests': selected_interests}
    return render(request, 'user_profile.html', d)


