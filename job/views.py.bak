def index(request):
    return render(request, 'index.html')


def contact_us(request):
    if request.method == 'POST':
        return render(request, 'contact_us.html', {'submitted': True})
    return render(request, 'contact_us.html', {'submitted': False})


def admin_login(request):
    error = ""
    if request.method == "POST":
        ur = (request.POST.get('uname') or '').strip()
        pd = request.POST.get('pwd') or ''
        user = None
        try:
            user = auth.authenticate(username=ur, password=pd)
        except Exception:
            user = None
        if user is None and ur:
            try:
                user_obj = User.objects.filter(email=ur).first()
                if user_obj:
                    user = auth.authenticate(username=user_obj.username, password=pd)
            except Exception:
                user = None
        if user is not None:
            try:
                if user.is_staff:
                    auth.login(request, user)
                    error = "no"
                else:
                    error = "yes"
            except Exception:
                error = "yes"
        else:
            error = "yes"
    d = {'error': error}
    return render(request, 'admin_login.html', d)


