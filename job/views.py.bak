from django.core.files.storage import default_storage
from django.core.files.base import ContentFile, File


def is_valid_gmail_email(email):
    if not email:
        return False
    value = email.strip()
    if value.count('@') != 1:
        return False
    local_part, domain = value.split('@', 1)
    return bool(local_part) and domain.lower() == 'gmail.com'


def is_valid_mobile_number(value):
    if not value:
        return False
    digits = ''.join(ch for ch in str(value).strip() if ch.isdigit())
    if len(digits) == 10 and digits[:1] in {'6', '7', '8', '9'}:
        return True
    if len(digits) == 12 and digits.startswith('91') and digits[2:3] in {'6', '7', '8', '9'}:
        return True
    return False


def _generate_signup_otp():
    return str(random.randint(100000, 999999))


def _save_temp_upload(uploaded_file):
    """Save an uploaded file to MEDIA_ROOT/temp_signups and return the storage path."""
    if not uploaded_file:
        return None
    folder = os.path.join('temp_signups')
    # unique filename
    name = f"temp_{uuid.uuid4().hex}_{uploaded_file.name}"
    rel_path = os.path.join(folder, name)
    # ensure folder exists in storage (FileSystemStorage will create subdirs as needed)
    saved = default_storage.save(rel_path, ContentFile(uploaded_file.read()))
    return saved


def _clear_pending_signup(request):
    # Attach any pending temp uploads to the created user/objects (if present), then clean up temp files
    pending = request.session.get('pending_signup_data') or {}
    try:
        if isinstance(pending, dict):
            email = (pending.get('email') or '').strip()
            if email:
                try:
                    user = User.objects.filter(email__iexact=email).first()
                    if user:
                        # If a student exists for this user, attach files
                        try:
                            student = StudentUser.objects.filter(user=user).first()
                            if student:
                                img_path = pending.get('image_temp')
                                if img_path and default_storage.exists(img_path):
                                    with default_storage.open(img_path, 'rb') as f:
                                        student.image.save(os.path.basename(img_path), File(f), save=True)
                                resume_path = pending.get('resume_temp')
                                if resume_path and default_storage.exists(resume_path):
                                    with default_storage.open(resume_path, 'rb') as f:
                                        student.resume.save(os.path.basename(resume_path), File(f), save=True)
                        except Exception:
                            pass

                        # If a recruiter exists for this user, attach image
                        try:
                            rec = Recuiter.objects.filter(user=user).first()
                            if rec:
                                img_path = pending.get('image_temp')
                                if img_path and default_storage.exists(img_path):
                                    with default_storage.open(img_path, 'rb') as f:
                                        rec.image.save(os.path.basename(img_path), File(f), save=True)
                        except Exception:
                            pass
                except Exception:
                    pass

            # cleanup temp files recorded in pending payload
            try:
                if isinstance(pending, dict):
                    for key in ('image_temp', 'resume_temp'):
                        path = pending.get(key)
                        if path and default_storage.exists(path):
                            try:
                                default_storage.delete(path)
                            except Exception:
                                pass
            except Exception:
                pass
    except Exception:
        pass

    for key in ['pending_signup_type', 'pending_signup_data', 'pending_signup_email_otp', 'pending_signup_mobile_otp', 'pending_signup_otp_time', 'pending_signup_demo_email_otp', 'pending_signup_demo_mobile_otp']:
        request.session.pop(key, None)


def _save_pending_signup(request, signup_type, payload):
    # create separate OTPs for email and mobile verification
    email_otp = _generate_signup_otp()
    mobile_otp = _generate_signup_otp()
    request.session['pending_signup_type'] = signup_type
    request.session['pending_signup_data'] = payload
    request.session['pending_signup_email_otp'] = email_otp
    request.session['pending_signup_mobile_otp'] = mobile_otp
    request.session['pending_signup_otp_time'] = time.time()
    # store demo OTP for mobile so it can be displayed in demo mode; do not expose email OTP in UI
    request.session['pending_signup_demo_mobile_otp'] = mobile_otp
    request.session['pending_signup_demo_email_otp'] = email_otp
    return email_otp, mobile_otp


def _find_user_by_identifier(identifier):
    value = (identifier or '').strip()
    if not value:
        return None

    user = None
    try:
        user = User.objects.get(username=value)
    except User.DoesNotExist:
        pass

    if user is None:
        try:
            user = User.objects.get(email=value)
        except User.DoesNotExist:
            pass

    if user is None:
        try:
            user = User.objects.get(username__iexact=value)
        except User.DoesNotExist:
            pass

    if user is not None:
        return user

    student_user = StudentUser.objects.filter(mobile=value).select_related('user').first()
    if student_user:
        return student_user.user

    recruiter = Recuiter.objects.filter(mobile=value).select_related('user').first()
    if recruiter:
        return recruiter.user

    return None


def _send_otp_email(user, otp):
    email_address = user.email or user.username
    if not email_address:
        return False
    subject = 'Password Reset OTP'
    message = f'Your OTP for password reset is: {otp}. It is valid for 30 seconds.'
    send_mail(subject, message, settings.DEFAULT_FROM_EMAIL or 'no-reply@example.com', [email_address], fail_silently=False)
    return True


def _normalize_mobile_number(value):
    cleaned = (value or '').strip()
    if not cleaned:
        return cleaned
    digits = ''.join(ch for ch in cleaned if ch.isdigit())
    if len(digits) == 10:
        return '+91' + digits
    if cleaned.startswith('+'):
        return cleaned
    if digits.startswith('91') and len(digits) > 10:
        return '+' + digits
    return cleaned if cleaned.startswith('+') else '+' + digits if digits else cleaned


def _send_otp_sms(user, otp):
    # Demo OTP mode: do not send real SMS. This keeps the app simple and works without Twilio setup.
    return True


def _detect_reset_channel(identifier):
    value = (identifier or '').strip()
    if value.isdigit() and len(value) >= 10:
        return 'mobile'
    return 'email'


def _clear_reset_session(request):
    request.session.pop('reset_user_id', None)
    request.session.pop('reset_otp', None)
    request.session.pop('reset_otp_time', None)
    request.session.pop('reset_verified', None)
    request.session.pop('reset_identifier', None)
    request.session.pop('reset_otp_channel', None)
    request.session.pop('reset_otp_demo', None)
    request.session.pop('reset_otp_error', None)


def _get_interest_keywords_from_user(user):
    if user is None:
        return []

    keywords = set()
    student = StudentUser.objects.filter(user=user).first()
    if student:
        for field in [student.qualification, student.interest, student.experience, student.gender]:
            for token in re.split(r'[,;|/]+', field or ''):
                cleaned = re.sub(r'[^A-Za-z0-9 ]', ' ', token).strip()
                if cleaned and len(cleaned) > 2:
                    keywords.add(cleaned.lower())
            keywords.update(part.lower() for part in re.split(r'[^A-Za-z0-9]+', field or '') if part and len(part) > 2)

    email = user.email or user.username or ''
    for application in Applyjob.objects.filter(email=email).order_by('-id')[:10]:
        for field in [application.qualification, application.experience, application.gender]:
            for token in re.split(r'[,;|/]+', field or ''):
                cleaned = re.sub(r'[^A-Za-z0-9 ]', ' ', token).strip()
                if cleaned and len(cleaned) > 2:
                    keywords.add(cleaned.lower())
            keywords.update(part.lower() for part in re.split(r'[^A-Za-z0-9]+', field or '') if part and len(part) > 2)

    if not keywords:
        for field in [user.first_name, user.last_name, user.email or user.username or '']:
            keywords.update(part.lower() for part in re.split(r'[^A-Za-z0-9]+', field or '') if part and len(part) > 2)

    return sorted(keywords)


def _normalize_tokens(value):
    tokens = set()
    if not value:
        return tokens
    for token in re.split(r'[,;|/]+', value):
        cleaned = re.sub(r'[^A-Za-z0-9 ]', ' ', token).strip()
        if cleaned:
            for part in cleaned.split():
                if len(part) > 2:
                    tokens.add(part.lower())
    return tokens


def _is_user_eligible_for_job(user, job):
    if user is None or not user.is_authenticated or job is None:
        return False

    student = StudentUser.objects.filter(user=user).first()
    if student is None:
        return False

    user_interest_tokens = set()
    for field in [student.interest, student.qualification, student.gender]:
        user_interest_tokens |= _normalize_tokens(field)

    job_tokens = set()
    for field in [job.title, job.skills, job.description, job.location]:
        job_tokens |= _normalize_tokens(field)

    if user_interest_tokens and (user_interest_tokens & job_tokens):
        return True

    if student.qualification and job.title and student.qualification.lower() in job.title.lower():
        return True

    if student.qualification and job.skills and student.qualification.lower() in job.skills.lower():
        return True

    try:
        if student.experience and job.experience:
            user_exp = int(str(student.experience).split()[0])
            job_exp = int(str(job.experience).split()[0])
            if user_exp < job_exp:
                return False
    except (TypeError, ValueError):
        pass

    return False


def _get_recommended_jobs_for_user(user):
    base_jobs = list(Job.objects.all().order_by('-creationdate', '-id'))
    if user is None or not user.is_authenticated:
        return base_jobs[:4]

    interest_keywords = _get_interest_keywords_from_user(user)
    if not interest_keywords:
        return base_jobs[:4]

    scored_jobs = []
    for job in base_jobs:
        searchable = ' '.join([
            job.title or '',
            job.skills or '',
            job.description or '',
            job.location or ''
        ]).lower()
        score = 0
        for keyword in interest_keywords:
            if keyword in searchable:
                score += 2
            if keyword in (job.title or '').lower():
                score += 3
        if score > 0:
            scored_jobs.append((score, job))

    if scored_jobs:
        scored_jobs.sort(key=lambda item: item[0], reverse=True)
        recommended = [job for _, job in scored_jobs[:4]]
        seen = {job.id for job in recommended}
        for job in base_jobs:
            if job.id not in seen:
                recommended.append(job)
                seen.add(job.id)
            if len(recommended) >= 4:
                break
        return recommended[:4]

    return base_jobs[:4]


