from django.core.mail import EmailMessage
from django.core.mail import EmailMultiAlternatives
from django.utils import timezone


def change_application_status(request, id):
    # Only authenticated recruiters for the job or staff can change status
    if not request.user.is_authenticated:
        return redirect('recuiter_login')

    try:
        application = Applyjob.objects.get(id=id)
    except Applyjob.DoesNotExist:
        return redirect('applied_condidate_list')

    # Determine the related job (if any)
    job = None
    try:
        job = Job.objects.get(id=application.num)
    except Job.DoesNotExist:
        job = None

    # Authorization: allow if staff or the job's recruiter
    allowed = False
    if request.user.is_staff:
        allowed = True
    else:
        if job and hasattr(job, 'recuiter') and job.recuiter and job.recuiter.user == request.user:
            allowed = True

    if not allowed:
        request.session['apply_message'] = 'You are not authorized to change application status for this job.'
        return redirect('applied_condidate_list')

    # Only accept POST requests to change status
    if request.method != 'POST':
        request.session['apply_message'] = 'Invalid request method.'
        return redirect('applied_condidate_list')

    action = request.POST.get('action', '').lower()
    if action in ('accept', 'accepted'):
        prev_status = application.status
        application.status = 'Accepted'
        application.status_changed_by = request.user
        application.status_changed_at = timezone.now()
        application.save()
        # record history
        try:
            ApplyjobHistory.objects.create(
                application=application,
                previous_status=prev_status,
                new_status=application.status,
                changed_by=request.user,
                changed_at=application.status_changed_at,
                note='Accepted by recruiter'
            )
        except Exception:
            pass

        # Enqueue interview invitation generation + email via background worker if possible
        try:
            from .tasks import enqueue_send_interview_email
            queued = enqueue_send_interview_email(application.id)
            if queued:
                request.session['apply_message'] = 'Application accepted and interview invitation queued for delivery.'
            else:
                request.session['apply_message'] = 'Application accepted but failed to queue interview invitation; attempted immediate send.'
        except Exception:
            # Fallback: attempt synchronous send
            try:
                from .tasks import send_interview_email
                ok = send_interview_email(application.id)
                if ok:
                    request.session['apply_message'] = 'Application accepted and interview invitation sent.'
                else:
                    request.session['apply_message'] = 'Application accepted but failed to send interview invitation.'
            except Exception:
                request.session['apply_message'] = 'Application accepted but failed to generate/send interview invitation.'

    elif action in ('reject', 'rejected'):
        application.status = 'Rejected'
        application.save()
        # Optional: send rejection email
        try:
            to_email = [application.email] if application.email else []
            if to_email:
                subject = f'Application outcome for {job.title if job else "your application"}'
                body = f'Dear {application.fname},\n\nWe regret to inform you that your application has not been successful. Thank you for your interest.\n\nBest regards,\nHR Team'
                from_email = settings.DEFAULT_FROM_EMAIL or 'no-reply@example.com'
                msg = EmailMessage(subject, body, from_email, to_email)
                msg.send(fail_silently=True)
        except Exception:
            pass
        request.session['apply_message'] = 'Application rejected.'

    else:
        request.session['apply_message'] = 'Unknown action.'

    return redirect('applied_condidate_list')


def latest_job(request):
    job = Job.objects.all()
    d = {'job': job}
    return render(request, 'latest_job.html', d)


from django.http import HttpResponse
from io import BytesIO
from reportlab.lib.pagesizes import A4
from reportlab.lib.units import mm
from reportlab.pdfgen import canvas


def _generate_interview_letter_pdf(application):
    buffer = BytesIO()
    c = canvas.Canvas(buffer, pagesize=A4)
    width, height = A4

    margin = 20 * mm
    x = margin
    y = height - margin

    # Header
    c.setFont('Helvetica-Bold', 16)
    c.drawString(x, y, 'Interview Invitation')
    y -= 12 * mm

    c.setFont('Helvetica', 11)
    job = None
    try:
        job = Job.objects.get(id=application.num)
    except Job.DoesNotExist:
        job = None

    c.drawString(x, y, f'Date: {date.today().strftime("%d %B %Y")}')
    y -= 8 * mm

    # Candidate details
    c.setFont('Helvetica-Bold', 12)
    c.drawString(x, y, f'To: {application.fname} {application.lname}')
    y -= 6 * mm
    c.setFont('Helvetica', 11)
    c.drawString(x, y, f'Email: {application.email} | Mobile: {application.mobile}')
    y -= 8 * mm

    # Body
    lines = []
    lines.append(f'Dear {application.fname},')
    lines.append('')
    if job:
        lines.append(f'We are pleased to invite you for an interview for the position of "{job.title}".')
        # Include interview location (use job.location)
        lines.append(f'Interview Location: {job.location or "TBD"}')
        # Use job.start_date as suggested interview date if present
        try:
            if job.start_date:
                lines.append(f'Suggested Interview Date: {job.start_date.strftime("%d %B %Y")}')
        except Exception:
            pass
        lines.append('')
    else:
        lines.append('We are pleased to invite you for an interview. Details will be shared by the recruiter.')
        lines.append('')

    lines.append('Please arrive 10 minutes before your scheduled time and bring a copy of your resume and any relevant identification documents.')
    lines.append('')
    lines.append('If you need to reschedule, please contact our HR team.')
    lines.append('')
    lines.append('Best regards,')
    lines.append('HR Team')
    lines.append('')
    lines.append('Best regards,')
    lines.append('HR Team')

    # Draw body text with wrapping
    text_obj = c.beginText()
    text_obj.setTextOrigin(x, y)
    text_obj.setFont('Helvetica', 11)
    max_width = width - 2 * margin

    for para in lines:
        # simple wrap
        words = para.split(' ')
        line = ''
        for w in words:
            test_line = (line + ' ' + w).strip()
            if c.stringWidth(test_line, 'Helvetica', 11) <= max_width:
                line = test_line
            else:
                text_obj.textLine(line)
                line = w
        if line:
            text_obj.textLine(line)
        text_obj.textLine('')

    c.drawText(text_obj)

    # Footer / signature placeholder
    c.line(x, margin + 30, x + 60 * mm, margin + 30)
    c.drawString(x, margin + 15, 'Authorized Signatory')

    c.showPage()
    c.save()
    buffer.seek(0)
    return buffer


def download_joining_letter(request, id):
    # Allow the applicant to download the interview invitation only if status is Accepted
    try:
        application = Applyjob.objects.get(id=id)
    except Applyjob.DoesNotExist:
        return redirect('user_home')

    if application.status != 'Accepted':
        # Not allowed
        request.session['apply_message'] = 'Interview invitation is available only for accepted applications.'
        return redirect('user_home')

    # Ensure only the applicant (by email) or recruiter/admin can download
    user = request.user
    user_email = (user.email or user.username) if user.is_authenticated else ''
    is_allowed = False
    if user.is_authenticated and user_email and user_email == application.email:
        is_allowed = True

    # allow staff
    if user.is_authenticated and user.is_staff:
        is_allowed = True

    # allow the job's recruiter
    try:
        job = Job.objects.get(id=application.num)
        if job and hasattr(job, 'recuiter') and job.recuiter and user.is_authenticated and job.recuiter.user == user:
            is_allowed = True
    except Job.DoesNotExist:
        pass

    if not is_allowed:
        request.session['apply_message'] = 'You are not authorized to download this interview invitation.'
        return redirect('user_home')

    pdf_buffer = _generate_interview_letter_pdf(application)
    filename = f'InterviewLetter_{application.fname}_{application.lname}_{application.id}.pdf'
    response = HttpResponse(pdf_buffer, content_type='application/pdf')
    response['Content-Disposition'] = f'attachment; filename="{filename}"'
    return response


def application_history(request, id):
    # Show audit history for an application. Accessible to staff, the job's recruiter, or the applicant.
    if not request.user.is_authenticated:
        return redirect('recuiter_login')

    try:
        application = Applyjob.objects.get(id=id)
    except Applyjob.DoesNotExist:
        return redirect('applied_condidate_list')

    # Authorization: staff, job's recruiter, or the applicant themselves
    allowed = False
    if request.user.is_staff:
        allowed = True
    else:
        try:
            job = Job.objects.get(id=application.num)
        except Job.DoesNotExist:
            job = None
        if job and job.recuiter and job.recuiter.user == request.user:
            allowed = True
        # applicant by email
        if application.email and (request.user.email == application.email or request.user.username == application.email):
            allowed = True

    if not allowed:
        request.session['apply_message'] = 'Not authorized to view application history.'
        return redirect('applied_condidate_list')

    history_entries = application.history.all().order_by('-changed_at')
    return render(request, 'applied_history.html', {'application': application, 'history': history_entries})


def application_history_dashboard(request):
    # Recruiter/admin dashboard listing history entries with simple filters and CSV export
    if not request.user.is_authenticated:
        return redirect('recuiter_login')

    if not request.user.is_staff and not Recuiter.objects.filter(user=request.user).exists():
        return redirect('recuiter_login')

    qs = ApplyjobHistory.objects.select_related('application', 'changed_by').all().order_by('-changed_at')

    # Filters: job id, application id, changed_by id, status
    job_id = request.GET.get('job_id')
    app_id = request.GET.get('application_id')
    changed_by = request.GET.get('changed_by')
    status = request.GET.get('status')

    if job_id:
        qs = qs.filter(application__num=job_id)
    if app_id:
        qs = qs.filter(application__id=app_id)
    if changed_by:
        qs = qs.filter(changed_by__id=changed_by)
    if status:
        qs = qs.filter(new_status__iexact=status)

    # CSV export
    if request.GET.get('export') == 'csv':
        import csv
        from django.http import HttpResponse
        response = HttpResponse(content_type='text/csv')
        response['Content-Disposition'] = 'attachment; filename="application_history.csv"'
        writer = csv.writer(response)
        writer.writerow(['Application ID', 'Job ID', 'Previous Status', 'New Status', 'Changed By', 'Changed At', 'Note'])
        for h in qs:
            writer.writerow([h.application.id, h.application.num, h.previous_status, h.new_status, (h.changed_by.get_full_name() if h.changed_by else ''), (h.changed_at.strftime('%Y-%m-%d %H:%M') if h.changed_at else ''), h.note or ''])
        return response

    # Pagination simple (manual)
    page = int(request.GET.get('page', '1') or '1')
    per_page = 25
    start = (page - 1) * per_page
    end = start + per_page
    total = qs.count()
    entries = qs[start:end]

    return render(request, 'applied_history_dashboard.html', {'entries': entries, 'total': total, 'page': page, 'per_page': per_page})


def delete_job(request, id):
    data = Job.objects.get(id=id)
    data.delete()
    return redirect('job_list')


def delete_condidate(request, id):
    data = Applyjob.objects.get(id=id)
    data.delete()
    return redirect('applied_condidate_list')
